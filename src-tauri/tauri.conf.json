{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VinePalmaPlayer",
  "appName": "vinepalma-player",
  "version": "0.2.0",
  "identifier": "com.vinepalma.player",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "VinePalma",
        "width": 620,
        "height": 680,
        "minWidth": 480,
        "minHeight": 540,
        "resizable": true,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "VinePalma Player 本地播放器",
    "longDescription": "VinePalma Player 是一个基于 FFmpeg 的现代化本地音视频播放器",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
