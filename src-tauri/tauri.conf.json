{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VinePalmaPlayer",
  "version": "0.3.0",
  "identifier": "com.vinepalma.player",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "VinePalma",
        "width": 620,
        "height": 680,
        "minWidth": 480,
        "minHeight": 540,
        "resizable": true,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "VinePalma 本地播放器 / local media player",
    "longDescription": "VinePalma Player 是一个基于 FFmpeg 的现代化本地音视频播放器，透明无边框窗口、迷你播放器、播放列表与字幕支持。A modern FFmpeg-based local audio/video player with a transparent frameless window, mini player, playlist and subtitle support.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
